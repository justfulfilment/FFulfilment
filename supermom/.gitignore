# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Figma source artwork: the 16MB PNG export is not committed. The shipped
# derivatives (hero.webp, hero@1x.webp, hero-lqip.txt) are. Re-export from
# Figma node 1:1393 if the originals are ever needed again.
/public/img/hero.png

# preview screenshots for review, not part of the app
/preview/
